# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary media and archive formats (never normalize line endings)
*.7z binary
*.zip binary
*.mp4 binary
*.mkv binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
